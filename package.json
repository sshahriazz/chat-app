{
  "name": "chat-app",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "turbo": "^2",
    "typescript": "^5.7"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "protobufjs@>=6.0.0 <7.5.6": ">=7.5.6 <8",
      "sharp@<0.35.0": ">=0.35.0 <0.36",
      "fast-uri@<3.1.3": ">=3.1.3 <4",
      "ws@<8.21.0": ">=8.21.0 <9",
      "hono@<4.12.25": ">=4.12.25 <5",
      "linkify-it@<5.0.2": ">=5.0.2 <6",
      "fast-xml-builder@<1.1.7": ">=1.1.7 <2",
      "postcss@<8.5.18": ">=8.5.18 <9"
    }
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": [
      "pnpm --filter @chat-app/web exec eslint"
    ]
  }
}
